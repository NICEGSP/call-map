{
  "name": "call-map",
  "version": "0.1.0",
  "type": "module",
  "description": "Call map: a DeepSeek Harness conversation view that shows which skills, MCP servers and subagents a session actually used, as a zoomable attribution tree.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "observability",
    "skills",
    "mcp",
    "subagents",
    "attribution"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon-180": "./assets/icon-180.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NICEGSP/call-map.git"
  },
  "homepage": "https://github.com/NICEGSP/call-map#readme",
  "bugs": {
    "url": "https://github.com/NICEGSP/call-map/issues"
  },
  "author": {
    "name": "NICEGSP"
  },
  "publishConfig": {
    "access": "public"
  }
}
